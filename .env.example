NODE_ENV=development
APP_NAME=xTrader
APP_ORIGIN=http://127.0.0.1:3000
APP_BIND=127.0.0.1
API_HOST=127.0.0.1
API_PORT=4000

# Leave empty to use bundled PostgreSQL (no Docker).
# Example: postgresql://xtrader:xtrader@127.0.0.1:54329/xtrader
DATABASE_URL=

# Backend only. Never prefix with NEXT_PUBLIC_.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ALLOWED_CLIENT_ID=
KITE_REDIRECT_URL=http://127.0.0.1:3000/zerodha/callback

# Generate: openssl rand -base64 48
SESSION_SECRET=
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_BASE64=
TOKEN_ENCRYPTION_KEY_VERSION=1

EXECUTION_MODE=PAPER
AGENT_MODE=MANUAL
LIVE_TRADING_ENABLED=false
AUTONOMOUS_TRADING_ENABLED=false
MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

PAPER_INITIAL_CAPITAL_INR=100000
MARKET_DATA_MAX_AGE_MS=5000
TRADE_APPROVAL_TTL_MS=15000

# Bundled Postgres listen port (loopback only).
EMBEDDED_POSTGRES_PORT=54329
EMBEDDED_POSTGRES_PASSWORD=xtrader
