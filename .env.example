NODE_ENV=production
APP_NAME=xTrader
APP_ORIGIN=http://localhost:3456
APP_BIND=127.0.0.1
API_HOST=127.0.0.1
API_PORT=4000

# Leave empty to use bundled PostgreSQL (no Docker).
# Example: postgresql://xtrader:xtrader@127.0.0.1:54329/xtrader
DATABASE_URL=

# Optional legacy — prefer entering key/secret in the first-run UI (encrypted vault).
# Leave blank for normal installs.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ALLOWED_CLIENT_ID=
KITE_REDIRECT_URL=http://localhost:3456/zerodha/callback

# Generate: openssl rand -base64 48
SESSION_SECRET=
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_BASE64=
TOKEN_ENCRYPTION_KEY_VERSION=1

MARKET_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

MARKET_DATA_MAX_AGE_MS=5000

# Bundled Postgres listen port (loopback only).
EMBEDDED_POSTGRES_PORT=54329
EMBEDDED_POSTGRES_PASSWORD=xtrader

# GitHub repo used for in-app update checks (owner/name).
UPDATE_REPO=that-rookie-dev/x-trader
