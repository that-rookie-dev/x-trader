{
  "name": "@xtrader/web",
  "version": "0.1.25",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=production next start -H 127.0.0.1 -p 3456",
    "watch": "next dev -H 127.0.0.1 -p 3456",
    "build": "next build && bash ../../scripts/prepare-web-standalone.sh",
    "start": "cd .next/standalone && NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3456 node apps/web/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.69.0",
    "lightweight-charts": "^4.2.3",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  }
}
